DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/venturino
MONGODB_URI=

# Base exclusivamente local que puede ser reemplazada por un snapshot de producción.
# El importador nunca utiliza DATABASE_URL para evitar restaurar sobre producción.
LOCAL_SNAPSHOT_DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/venturino
LOCAL_SNAPSHOT_ALLOWED_HOSTS=localhost,127.0.0.1,::1
LOCAL_SNAPSHOT_MAINTENANCE_DATABASE=postgres

# Acceso actual de Venturino. Se conserva sin cambios.
AUTH_USER=admin
AUTH_PASSWORD=

# Acceso interno exclusivo de Algorym. Debe usar un usuario distinto de AUTH_USER.
SUPERADMIN_USER=
SUPERADMIN_PASSWORD=


JWT_SECRET=

# Integración servidor a servidor con Padawanway.
PADAWANWAY_API_ENABLED=false
PADAWANWAY_API_CLIENT_ID=padawanway
PADAWANWAY_API_SECRET=
PADAWANWAY_API_MAX_SKEW_SECONDS=300
PADAWANWAY_API_RATE_LIMIT_PER_MINUTE=60

# Reglas internas del servicio; no se incluyen en las respuestas.
MARKET_REFERENCE_YEAR_TOLERANCE=2
MARKET_REFERENCE_EXTENDED_YEAR_TOLERANCE=5
MARKET_REFERENCE_DESIRED_SAMPLE_SIZE=3

# Alertas operativas por email. Sólo se activan en producción con el flag explícito.
APP_ENV=development
APP_RELEASE=
ALERT_EMAIL_ENABLED=false
ALERT_SERVICE_NAME=venturino
ALERT_COOLDOWN_SECONDS=900
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_TO=algorym.adm@gmail.com
SMTP_FROM=
