DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/venturino
MONGODB_URI=
AUTH_USER=admin
AUTH_PASSWORD=
JWT_SECRET=

# Integración servidor a servidor con Padway.
PADWAY_API_ENABLED=false
PADWAY_API_CLIENT_ID=padway
PADWAY_API_SECRET=
PADWAY_API_MAX_SKEW_SECONDS=300
PADWAY_API_RATE_LIMIT_PER_MINUTE=60

# Reglas internas del servicio; no se incluyen en las respuestas.
MARKET_REFERENCE_YEAR_TOLERANCE=2
MARKET_REFERENCE_EXTENDED_YEAR_TOLERANCE=5
MARKET_REFERENCE_DESIRED_SAMPLE_SIZE=3
